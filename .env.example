# LI Lite configuration
# Copy to .env and fill in values

# Gemini LLM (required for discovery)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash-preview-04-17

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Credential staleness warning (days)
CREDS_STALE_WARNING_DAYS=14
